SELECT ItemName,Month,Price,
    LAG(Price, 1) OVER (PARTITION BY ItemName ORDER BY Month) AS PrevMonthPrice,
    LEAD(Price, 1) OVER (PARTITION BY ItemName ORDER BY Month) AS NextMonthPrice
FROM Groceries;

//MAX AND MIN
SELECT ItemName,Price,
    MAX(Price) OVER () AS MaxPrice,
    MIN(Price) OVER () AS MinPrice
FROM Groceries;


